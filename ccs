#!/usr/bin/env bash
# Start (or attach to) a tmux session with a Claude sessions sidebar on the left.
set -e
case "${1:-}" in
  kill|stop)    tmux kill-session -t claude 2>/dev/null && echo "Stopped." || echo "Nothing running."; exit 0 ;;
  restart)      tmux kill-session -t claude 2>/dev/null || true ;;
  ""|start)     ;;
  *)            echo "usage: ccs [start|kill|restart]"; exit 1 ;;
esac
DIR="$HOME/.claude/session-sidebar"
W="${CCS_WIDTH:-28}"
SB="python3 $DIR/sidebar.py"
PIN="$DIR/pin.sh"
if ! tmux has-session -t claude 2>/dev/null; then
  tmux new-session -d -s claude -x "$(tput cols)" -y "$(tput lines)" -c "$PWD"
  tmux split-window -t claude -hb -l "$W" -c "$PWD" "printf '\\033]2;claude-sidebar\\033\\\\'; $SB"
  tmux select-pane -t claude -R
  tmux set-option -g mouse on
  tmux bind-key h select-pane -L
  tmux bind-key l select-pane -R
  # every new window also gets a sidebar; keep sidebars at a fixed width
  tmux set-hook -t claude after-new-window "split-window -hb -l $W \"printf '\\\\033]2;claude-sidebar\\\\033\\\\\\\\'; $SB\" ; select-pane -R"
  tmux set-hook -t claude client-attached "run-shell \"CCS_WIDTH=$W $PIN\""
  tmux set-hook -t claude client-resized "run-shell \"CCS_WIDTH=$W $PIN\""
fi
if [ -n "$TMUX" ]; then tmux switch-client -t claude; else tmux attach -t claude; fi
